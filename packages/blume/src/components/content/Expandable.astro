---
import data from "blume:data";

import AccordionItem from "./AccordionItem.astro";
import { contentStrings } from "./content-strings.ts";

const { content: strings } = contentStrings(data, Astro.currentLocale);
const { defaultOpen = false, title = strings.showMore } = Astro.props;
---

<div class="not-prose my-4 overflow-hidden rounded-blume border border-border">
  <AccordionItem defaultOpen={defaultOpen} title={title}>
    <slot />
  </AccordionItem>
</div>
