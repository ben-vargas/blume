---
import data from "blume:data";

import { contentStrings } from "./content-strings.ts";
import { renderInlineMarkdown } from "./inline-markdown.ts";
import { promptMarkdown } from "./prompt-markdown.ts";

interface Props {
  actions?: boolean | string | string[];
  description: string;
}

const { actions = ["copy"], description } = Astro.props;

const normalizeActions = (value: Props["actions"]): string[] => {
  if (Array.isArray(value)) {
    return value;
  }
  if (typeof value === "string") {
    return [value];
  }
  return value === false ? [] : ["copy"];
};

const enabledActions = new Set(normalizeActions(actions));
const descriptionHtml = await renderInlineMarkdown(description);
// The prompt as Markdown, for the copy button and the Cursor link: the rendered
// body's text alone would drop its links, list markers, and code fences.
const promptSource = Astro.slots.has("default")
  ? promptMarkdown(await Astro.slots.render("default"))
  : "";
const { actions: actionStrings, content: strings } = contentStrings(
  data,
  Astro.currentLocale
);

const primaryButton =
  "inline-flex h-8 cursor-pointer items-center rounded-lg bg-accent px-3.5 font-medium text-accent-foreground text-xs transition hover:bg-accent/90";
const secondaryButton =
  "inline-flex h-8 cursor-pointer items-center rounded-lg border border-border bg-background px-3.5 font-medium text-muted-foreground text-xs transition hover:border-accent hover:text-accent";
---

<blume-prompt
  class="not-prose my-6 block rounded-blume border border-border bg-muted/30"
  data-blume-prompt-markdown={promptSource}
>
  <div class="flex items-center justify-between gap-3 px-4 py-3">
    <p
      class="m-0! text-foreground text-sm [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_strong]:font-semibold [&_strong]:text-foreground"
      data-blume-prompt-description
      set:html={descriptionHtml}
    />
    {
      enabledActions.size > 0 && (
        <div class="flex shrink-0 items-center gap-2">
          {enabledActions.has("copy") && (
            <button
              class={primaryButton}
              data-blume-prompt-copy
              data-copied={actionStrings.copied}
              type="button"
            >
              {/* Both labels share one grid cell so the button is always sized
                  to the wider one — swapping to the copied label on copy can't
                  resize it and shift the description beside it. */}
              <span class="grid *:col-start-1 *:row-start-1 *:text-center">
                <span data-blume-prompt-copy-idle>{strings.copyPrompt}</span>
                <span aria-hidden="true" class="invisible" data-blume-prompt-copy-done>
                  {actionStrings.copied}
                </span>
              </span>
            </button>
          )}
          {enabledActions.has("cursor") && (
            <a
              class={secondaryButton}
              data-blume-prompt-cursor
              href={`cursor://anysphere.cursor-deeplink/prompt?text=${encodeURIComponent(promptSource)}`}
            >
              {actionStrings.openIn.replace("{name}", "Cursor")}
            </a>
          )}
        </div>
      )
    }
  </div>
</blume-prompt>

<script>
  import { copyText, createCopyFlash } from "../copy-feedback.ts";

  class BlumePrompt extends HTMLElement {
    connectedCallback() {
      // Serialized to Markdown at build time; the Cursor link already carries
      // it in its href.
      const promptText = this.dataset.blumePromptMarkdown ?? "";

      const copy = this.querySelector<HTMLButtonElement>(
        "[data-blume-prompt-copy]"
      );
      const idle = copy?.querySelector<HTMLElement>(
        "[data-blume-prompt-copy-idle]"
      );
      const done = copy?.querySelector<HTMLElement>(
        "[data-blume-prompt-copy-done]"
      );
      // Toggle visibility rather than swapping text: both labels occupy the
      // same grid cell, so the button width never changes.
      const flash = createCopyFlash((copied) => {
        idle?.classList.toggle("invisible", copied);
        done?.classList.toggle("invisible", !copied);
      }, copy?.dataset.copied ?? "Copied!");
      copy?.addEventListener("click", async () => {
        if (promptText && (await copyText(promptText))) {
          flash();
        }
      });
    }
  }

  if (!customElements.get("blume-prompt")) {
    customElements.define("blume-prompt", BlumePrompt);
  }
</script>
