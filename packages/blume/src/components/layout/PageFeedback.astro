---
import data from "blume:data";

import { EN_UI } from "../../core/i18n-ui.ts";
import type { UIStrings } from "../../core/i18n-ui.ts";
import Icon from "../Icon.astro";
import { COMMENT_MAX_LENGTH } from "./page-feedback.ts";

interface Props {
  /** Ask for a written comment after the rating (`feedback.comments`). */
  comments?: boolean;
  /** Localized feedback labels. */
  strings?: UIStrings["feedback"];
}

const { comments = false, strings } = Astro.props;
// Answers go through analytics, so under a consent layer the rating waits,
// hidden, until the reader allows analytics (`page-feedback.ts` shows it).
const waitsForConsent = data.config.consent !== null;
// Merge over the English baseline per key (rather than `strings ?? …`) so a
// partial — or empty `{}` — strings object still resolves every label to a
// default, matching the pattern PageActions and Search use.
const f = { ...EN_UI.feedback, ...strings };

const buttonClass =
  "inline-flex items-center gap-2 rounded-blume border border-border px-4 py-2 text-foreground text-sm transition-colors hover:border-foreground";
---

<section
  aria-label={f.question}
  class="mx-auto mt-12 max-w-content border-border border-t pt-6"
  data-blume-page-feedback
  hidden={waitsForConsent}
>
  <div class="flex items-center justify-between gap-4">
    <p class="text-muted-foreground text-sm">{f.question}</p>
    <div class="flex items-center gap-2" data-feedback-actions>
      <button class={buttonClass} data-feedback-value="yes" type="button">
        <Icon name="thumbs-up" size={16} />
        {f.yes}
      </button>
      <button class={buttonClass} data-feedback-value="no" type="button">
        <Icon name="thumbs-down" size={16} />
        {f.no}
      </button>
    </div>
    <p
      class="hidden text-muted-foreground text-sm focus:outline-none"
      data-feedback-thanks
      role="status"
      tabindex="-1"
    >
      {f.thanks}
    </p>
  </div>
  {
    comments && (
      <form class="mt-4 grid gap-2" data-feedback-form hidden>
        <label class="text-muted-foreground text-sm" for="blume-feedback-comment">
          {f.comment}
        </label>
        <textarea
          class="w-full resize-y rounded-blume border border-border bg-background px-3 py-2 text-foreground text-sm outline-none transition-colors focus:border-foreground"
          id="blume-feedback-comment"
          maxlength={COMMENT_MAX_LENGTH}
          name="comment"
          rows="3"
        ></textarea>
        <div>
          <button class={buttonClass} type="submit">
            {f.send}
          </button>
        </div>
      </form>
    )
  }
</section>

<script>
  import { initFeedback, syncFeedbackVisibility } from "./page-feedback.ts";

  initFeedback();
  document.addEventListener("astro:after-swap", initFeedback);
  addEventListener("blume:consent", syncFeedbackVisibility);
</script>
