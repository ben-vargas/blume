---
import { consentHead } from "../../consent/head.ts";
import { CONSENT_INIT_SCRIPT } from "../../consent/init.ts";
import type { BlumeDataConfig } from "../../core/data.ts";

// The consent layer's <head> output, rendered ahead of `Analytics.astro` by
// every layout when `consent` is configured: the inline script that creates
// `window.blumeConsent` (`consent/init.ts`), the adapter's own tags — a
// hosted consent manager's loader and the bridge that reports its answers —
// and the runtime that runs the held analytics (`consent/client.ts`). Like
// analytics, a hosted manager loads in production builds only; `native()`
// has no tags and works in `blume dev` too.
interface Props {
  consent: NonNullable<BlumeDataConfig["consent"]>;
}

const { consent } = Astro.props;
const tags = import.meta.env.PROD ? consentHead(consent) : [];
---

<script data-kind={consent.kind} is:inline set:html={CONSENT_INIT_SCRIPT} />
{
  tags.map((tag) =>
    tag.content === null ? (
      <script is:inline {...tag.attributes} />
    ) : (
      <script is:inline set:html={tag.content} {...tag.attributes} />
    )
  )
}
<script>
  import { startConsent } from "../../consent/client.ts";

  startConsent();
</script>
