---
// The site footer `footer` in blume.config.ts configures: social profile
// icons and up to four link columns, below the content on every page. Renders
// nothing when `footer` is unset; a `components.ts` `Footer` replaces it.
import type { BlumeDataConfig } from "../../core/data.ts";
import { newTabAttrs } from "../../core/new-tab.ts";
import Icon from "../Icon.astro";
import { withBase } from "../islands/base-path.ts";
import { footerSocialLinks } from "./footer-socials.ts";

interface Props {
  footer?: BlumeDataConfig["footer"];
}

const { footer } = Astro.props;
const socials = footer ? footerSocialLinks(footer.socials) : [];
const columns = footer?.links ?? [];
// Literal classes, so Tailwind's scan sees every one.
const COLUMN_CLASSES = [
  "sm:grid-cols-1",
  "sm:grid-cols-2",
  "sm:grid-cols-3",
  "sm:grid-cols-4",
];
const linkClass =
  "text-muted-foreground transition-colors hover:text-foreground focus-visible:text-foreground";
---

{
  (socials.length > 0 || columns.length > 0) && (
    <footer
      class="border-border border-t px-4 py-10 md:px-6"
      data-blume-footer
    >
      <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
        {socials.length > 0 && (
          <ul class="flex flex-wrap items-center gap-4">
            {socials.map((social) => (
              <li>
                <a
                  aria-label={social.label}
                  class:list={[linkClass, "flex"]}
                  href={withBase(social.href)}
                  title={social.label}
                  {...newTabAttrs(social.href)}
                >
                  {social.path ? (
                    <svg
                      aria-hidden="true"
                      fill="currentColor"
                      height="18"
                      viewBox="0 0 24 24"
                      width="18"
                    >
                      <path d={social.path} />
                    </svg>
                  ) : (
                    <Icon name={social.icon} size={18} />
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
        {columns.length > 0 && (
          <div
            class:list={[
              "grid grid-cols-2 gap-8 text-sm",
              COLUMN_CLASSES[columns.length - 1],
            ]}
          >
            {columns.map((column, index) => (
              <div class="flex flex-col gap-3">
                {column.label && (
                  <p
                    class="font-medium text-foreground"
                    id={`blume-footer-column-${index}`}
                  >
                    {column.label}
                  </p>
                )}
                <ul
                  aria-labelledby={
                    column.label ? `blume-footer-column-${index}` : undefined
                  }
                  class="flex flex-col gap-2"
                >
                  {column.items.map((item) => (
                    <li>
                      <a
                        class={linkClass}
                        href={withBase(item.href)}
                        {...newTabAttrs(item.href)}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </div>
    </footer>
  )
}
