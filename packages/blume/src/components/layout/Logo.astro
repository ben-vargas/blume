---
import data from "blume:data";
import { withBase } from "../islands/base-path.ts";
// The site brand: the logo mark (inline SVG so a `currentColor` mark follows the
// theme, or light/dark `<img>` variants) followed by the site title, wrapped in
// a link to the brand href. Extracted from the header so it can be replaced on
// its own through the `Logo` layout slot (`defineComponents({ layout: { Logo } })`).
import type { BlumeLogo } from "../../core/data.ts";
import { localizeInternalPath } from "../../core/i18n.ts";

interface Props {
  site: { title: string };
  logo?: BlumeLogo | null;
  /**
   * Active locale of the page. The brand link follows it the way the header
   * tabs do (`/` -> `/en` under a prefixed locale), so clicking the logo never
   * drops a reader out of the language they were reading. Absent, the link is
   * emitted as configured.
   */
  locale?: string;
}

const { site, logo, locale } = Astro.props;

// The logo is resolved upstream: an inline `svg` (so a currentColor mark follows
// the theme) or image URL(s) for an <img>.
const logoSvg = logo?.svg;
const logoLight = logo?.light;
const logoDark = logo?.dark ?? logo?.light;
const logoLightDimensions = logo?.dimensions?.light;
const logoDarkDimensions = logo?.dimensions?.dark ?? logo?.dimensions?.light;
const logoAlt = logo?.alt ?? "";
// The configured `logo.href` (default `/`) is authored in the default locale's
// path space, like a tab path; localize it for the page's locale. The locale's
// navigation carries it resolved against the routes the build serves (a custom
// home page exists only at `/`, so it isn't moved to `/fr`). External and
// protocol-relative hrefs pass through, and `withBase` layers the deployment
// base on afterwards, so the locale prefix sits inside the base like every
// other localized route.
const configuredHref = logo?.href ?? "/";
const brandHref =
  locale === undefined
    ? configuredHref
    : (data.navigationByLocale[locale]?.brandHref ??
      localizeInternalPath(configuredHref, locale, data.config.i18n));
// Wordmark beside the mark: the configured `logo.text`, or the site title when
// it's omitted. An explicit `""` hides it (an image-only logo whose mark already
// carries the wordmark).
const brandText = logo?.text ?? site.title;
---

<a
  class="inline-flex min-w-0 items-center gap-2 font-semibold text-base text-foreground"
  href={withBase(brandHref)}
>
  {
    logoSvg && (
      <span
        aria-hidden="true"
        class="inline-flex h-5 shrink-0 items-center [&>svg]:h-5 [&>svg]:w-auto"
        set:html={logoSvg}
      />
    )
  }
  {
    !logoSvg &&
      logoLight &&
      (logoLight === logoDark ? (
        <img
          alt={logoAlt}
          class="h-5 w-auto shrink-0"
          height={logoLightDimensions?.height}
          src={withBase(logoLight)}
          width={logoLightDimensions?.width}
        />
      ) : (
        <>
          <img
            alt={logoAlt}
            class="h-5 w-auto shrink-0 dark:hidden"
            height={logoLightDimensions?.height}
            src={withBase(logoLight)}
            width={logoLightDimensions?.width}
          />
          <img
            alt={logoAlt}
            class="hidden h-5 w-auto shrink-0 dark:block"
            height={logoDarkDimensions?.height}
            src={withBase(logoDark)}
            width={logoDarkDimensions?.width}
          />
        </>
      ))
  }
  {brandText && <span class="truncate">{brandText}</span>}
</a>
