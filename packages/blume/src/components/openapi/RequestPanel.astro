---
import data from "blume:data";

import { highlightCode } from "../../markdown/index.ts";
import {
  type ComponentsLike,
  responseExample,
  type SchemaLike,
  type SpecValue,
  toJson,
} from "./helpers.ts";
import type { CustomCodeSample } from "./code-samples.ts";
import { languageSamplePanels } from "./sample-panels.ts";
import PanelTabs from "./PanelTabs.astro";
import type { RequestSample, SampleLanguage } from "./snippets.ts";

interface MediaTypeLike {
  schema?: SchemaLike;
  example?: SpecValue;
  examples?: SpecValue;
}

interface ResponseLike {
  description?: string;
  content?: Record<string, MediaTypeLike>;
}

interface Props {
  /** The document's `components`, which `$ref`'d examples resolve against. */
  components?: ComponentsLike;
  /** The spec's hand-written `x-codeSamples`, shown first and never re-rendered live. */
  customSamples?: CustomCodeSample[];
  /**
   * A webhook's body: the rail shows it as a "Payload" example per media
   * type in place of client code, since the API sends the request.
   */
  payload?: Record<string, MediaTypeLike>;
  sample?: RequestSample;
  languages?: SampleLanguage[];
  responses: Record<string, ResponseLike>;
  schemas: Record<string, SchemaLike>;
}

const {
  components,
  customSamples = [],
  payload,
  sample,
  languages = [],
  responses,
  schemas,
} = Astro.props;

/** A media type's example, highlighted, or null when it has none. */
const highlightExample = async (media: MediaTypeLike, type: string) => {
  const example = responseExample(media, schemas, components);
  if (example === undefined || example === null) {
    return null;
  }
  const json = type.includes("json");
  return highlightCode(
    json || typeof example !== "string" ? toJson(example) : example,
    json ? "json" : "text",
    { icons: false, themes: data.config.codeThemes }
  );
};

// Hand-written samples carry no `lang` key, so the playground leaves them
// as written when it re-renders the generated ones from the form.
const customPanels = await Promise.all(
  customSamples.map(async (custom) => ({
    html: await highlightCode(custom.source, custom.lang, {
      icons: false,
      themes: data.config.codeThemes,
    }),
    key: custom.key,
    label: custom.label,
  }))
);
const payloadPanels = await Promise.all(
  Object.entries(payload ?? {}).map(async ([type, media]) => ({
    html: await highlightExample(media, type),
    key: type,
    label: type,
    text: "No example payload.",
  }))
);
const requestPanels = [
  ...customPanels,
  ...(sample
    ? await languageSamplePanels(languages, sample, data.config.codeThemes)
    : []),
];

const responsePanels = await Promise.all(
  Object.entries(responses).map(async ([status, response]) => {
    const media =
      Object.entries(response.content ?? {}).find(([type]) =>
        type.includes("json")
      )?.[1] ?? Object.values(response.content ?? {})[0];
    const example = media ? responseExample(media, schemas, components) : undefined;
    const html =
      example === undefined || example === null
        ? null
        : await highlightCode(toJson(example), "json", {
            icons: false,
            themes: data.config.codeThemes,
          });
    return {
      html,
      key: status,
      label: status,
      text: response.description || "No example response.",
    };
  })
);
---

<div class="not-prose flex flex-col gap-6">
  <PanelTabs copy heading="Payload" mono panels={payloadPanels} />
  <PanelTabs copy heading="Request" panels={requestPanels} />
  <PanelTabs heading="Response" mono panels={responsePanels} />
</div>
