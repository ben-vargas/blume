---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Audit from "./_cli/Audit.astro";
import Build from "./_cli/Build.astro";
import Checks from "./_cli/Checks.astro";
import Ci from "./_cli/Ci.astro";
import CommandIndex from "./_cli/CommandIndex.astro";
import Eval from "./_cli/Eval.astro";
import Hero from "./_cli/Hero.astro";
import Own from "./_cli/Own.astro";
import Translate from "./_cli/Translate.astro";
import Footer from "./_home/Footer.astro";
import InstallCta from "./_home/InstallCta.astro";
import Motion from "./_home/Motion.astro";
import { installCopyScript } from "./_home/shared.ts";

// The CLI landing page, in the homepage's design language but with its own
// hero (an asymmetric split over a bloom tray where the lifecycle session types
// itself out). The rest is organized by job rather than by command, so every
// command has a home: building (init, dev, build, preview), correctness
// (validate, check, doctor, then the `audit` dark panel), agents (`eval` and
// `translate`), and growing and owning the site (version, sync, add, eject),
// then the CI gates and the full command index.
// PageLayout supplies the document shell, header, theme, and fonts, and — with
// siteUrl + ogEnabled — this page's canonical and generated OG card.
const { config } = data;
const pageTitle = `${config.title} CLI — everything your docs need, one command away`;
const pageDescription =
  "One CLI to scaffold, preview, build, validate, audit, evaluate, and translate your docs, fast by default and ready for CI and your coding agents.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/cli", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <Hero />

    <Build />

    <Checks />

    <Audit />

    <Eval />

    <Translate />

    <Own />

    <Ci />

    <CommandIndex />

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <Footer slot="footer" />
</PageLayout>
