---
// A split feature section: a two-tone heading and a hairline-divided list of
// bold lead-ins on one side, a visual (the default slot) on the other. The
// text always comes first on mobile; `reverse` moves the visual to the left
// from `lg` up, so consecutive splits can alternate.
import SectionHeading from "./SectionHeading.astro";
import { inlineCode } from "./shared.ts";
import TextLink from "./TextLink.astro";

interface Item {
  body: string;
  title: string;
}

interface Props {
  items: Item[];
  link?: { href: string; label: string };
  reverse?: boolean;
  tagline: string;
  title: string;
}

const { items, link, reverse = false, tagline, title } = Astro.props;
---

<section class="grid items-center gap-x-16 gap-y-12 lg:grid-cols-2">
  <div>
    <SectionHeading tagline={tagline} title={title} />
    <dl class="mt-10 divide-y divide-border border-border border-t">
      {
        items.map((item) => (
          <div class="text-pretty py-4 text-base sm:text-sm">
            <dt class="inline font-medium text-foreground">{item.title}</dt>{" "}
            <dd
              class="inline text-muted-foreground"
              set:html={inlineCode(item.body)}
            />
          </div>
        ))
      }
    </dl>
    {
      link && (
        <div class="mt-6">
          <TextLink href={link.href}>{link.label}</TextLink>
        </div>
      )
    }
  </div>
  <div class:list={["min-w-0", reverse && "lg:order-first"]}>
    <slot />
  </div>
</section>
