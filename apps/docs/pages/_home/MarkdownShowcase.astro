---
// "Markdown with superpowers." — a split with the visual on the left: an MDX
// source card and its rendered page overlapping on a sky tray. The rendered
// side leans on the real shipped <Callout> so the preview is genuinely
// Blume-rendered, not a look-alike. The cards overlap on a shared grid row
// rather than with negative margins, so the overlap holds at every width.
import Callout from "blume/components/content/Callout.astro";
import Icon from "blume/components/Icon.astro";
import Split from "./Split.astro";
import Tray from "./Tray.astro";
import { icons } from "./shared.ts";

const items = [
  {
    body: "`:::tip`, `:::warning`, and friends render as styled callouts, with nothing to import.",
    title: "Directives become callouts.",
  },
  {
    body: "A `package-install` fence renders npm, pnpm, yarn, bun, nub, and aube commands as tabs.",
    title: "Package names become install tabs.",
  },
  {
    body: "Shiki highlights at build time, with titles, line numbers, highlighting, and TypeScript-to-JavaScript tabs.",
    title: "Code, highlighted.",
  },
  {
    body: "KaTeX math renders at build time with no client JavaScript, and Mermaid diagrams load only on the pages that draw them.",
    title: "Math and diagrams.",
  },
];

// Declared as a string and rendered through an Astro expression so the
// Markdown inside auto-escapes (no hand-written entities).
const showcaseSource = `---
title: Installation
---

Install **Blume** with your package manager:

\`\`\`package-install
blume
\`\`\`

:::tip
Search, theming, and navigation work out of the box.
:::`;

const packageManagers = ["npm", "pnpm", "yarn", "bun", "nub", "aube"];
---

<Split
  tagline="No imports, no JSX to manage."
  items={items}
  link={{ href: "/docs/content/syntax", label: "See the full syntax" }}
  reverse
  title="Markdown with superpowers."
>
  <Tray innerClass="flex flex-col justify-center lg:min-h-[520px]" tone="sky">
    <div
      class="grid grid-cols-12 grid-rows-[auto_--spacing(12)_auto] p-6 sm:p-8"
      data-nosnippet
      data-reveal
    >
      <!-- Source -->
      <div
        class="reveal-rise col-start-1 col-end-13 row-start-1 row-end-3 overflow-hidden rounded-2xl bg-background shadow-xl shadow-[rgb(28_40_64/0.12)] ring-1 ring-foreground/5 sm:col-end-11 dark:shadow-none"
      >
        <div
          class="flex items-center gap-2 border-border border-b px-4 py-2.5 text-muted-foreground text-xs"
        >
          <svg
            aria-hidden="true"
            class="size-3.5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            set:html={icons.fileCode}
          />
          <p class="font-mono">installation.mdx</p>
        </div>
        <!-- Wraps at every width rather than scrolling: in the split's narrow
             column (`lg` to `xl`) a scrolling source would be a region the
             keyboard can't reach. -->
        <pre
          class="whitespace-pre-wrap p-4 pb-16 font-mono text-[0.75rem]/5 text-foreground sm:text-[0.8125rem]/6"><code>{showcaseSource}</code></pre>
      </div>

      <!-- Rendered -->
      <div
        class="reveal-rise z-10 col-start-1 col-end-13 row-start-2 row-end-4 rounded-2xl [--reveal-delay:350ms] bg-background p-5 shadow-xl shadow-[rgb(28_40_64/0.18)] ring-1 ring-foreground/5 sm:col-start-3 dark:shadow-none dark:inset-ring dark:inset-ring-white/5 [&_aside]:mb-0"
      >
        <p class="font-semibold text-foreground text-lg">Installation</p>
        <p class="mt-2 text-muted-foreground text-sm">
          Install <strong class="font-semibold text-foreground">Blume</strong>{" "}
          with your package manager:
        </p>
        <!-- Tabs keep their width; on a narrow phone the last ones run off the
             edge, as the real strip does before it scrolls. -->
        <div class="mt-3 overflow-hidden rounded-blume ring-1 ring-border">
          <div
            class="flex items-center gap-4 border-border border-b bg-muted/40 px-4 text-xs"
          >
            {
              packageManagers.map((pm, i) => (
                <span
                  class:list={[
                    "shrink-0 border-b-2 py-2",
                    i === 0
                      ? "border-accent text-foreground"
                      : "border-transparent text-muted-foreground",
                  ]}
                >
                  {pm}
                </span>
              ))
            }
          </div>
          <div
            class="flex items-center justify-between px-4 py-3 font-mono text-foreground text-xs"
          >
            <p><span class="text-muted-foreground">npm</span> install blume</p>
            <Icon class="size-3.5 text-muted-foreground" name="copy" size={14} />
          </div>
        </div>
        <Callout type="tip">
          Search, theming, and navigation work out of the box.
        </Callout>
      </div>
    </div>
  </Tray>
</Split>
