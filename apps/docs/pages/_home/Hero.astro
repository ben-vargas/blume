---
// Landing hero: a full-bleed radial gradient, deep blue at the top fading into
// the page background by the bottom, with the latest-release badge, headline,
// install box, and doc/GitHub links in white on the blue and the product
// preview sitting on the fade below them. It lives outside the page container
// so the gradient spans the viewport, and pulls itself up under the sticky
// header (`h-16` in Header.astro) so the blue starts at the top of the page;
// the page passes `transparentHeader` to PageLayout so the header sits over it
// see-through until the page scrolls. The gradient's tail is mixed toward
// `--blume-background`, so it lands on white in light mode and on the dark
// surface in dark mode; dark mode also swaps the blue stops for a night-sky
// navy so toggling the theme reads as day turning to night. The install box copy
// button uses the page-level delegated `data-blume-copy-install` handler in
// index.astro.
import data from "blume:data";
import InstallBox from "./InstallBox.astro";
import ProductPreview from "./ProductPreview.astro";
import { glyph } from "./shared.ts";

const { config } = data;
const repoUrl = config.repoUrl;
const docsHref = "/docs";
const chevronRight = glyph("chevron-right");

// Latest release for the hero badge, read from the changelog the
// `githubReleases` content source materializes (`/changelog/<tag>` routes,
// titled by release name, e.g. `blume@1.7.3`). The source already fetches
// with `GITHUB_TOKEN` and keeps a snapshot cache, so the badge can never
// disagree with /changelog — an unauthenticated fetch from a CI runner used to
// hit GitHub's rate limit and silently leave the badge on its fallback.
const toTime = (value: string | null): number =>
  value ? new Date(value).getTime() : 0;
const latestRelease = data.routes
  .filter((route) => route.path.startsWith("/changelog/") && !route.draft)
  .toSorted((a, b) => toTime(b.lastModified) - toTime(a.lastModified))
  .at(0);
// Release names are changesets-style (`blume@1.0.0`), but tolerate a plain
// `v1.0.0` too — drop any package prefix and the leading `v`.
const latestVersion = latestRelease
  ? latestRelease.title.replace(/^.*@/u, "").replace(/^v/u, "")
  : "0.0.0";
---

<section
  class="hero-gradient -mt-16 overflow-hidden px-6 pt-36 text-white sm:pt-44"
>
  <div class="mx-auto max-w-[1400px]">
    <a
      class="inline-flex items-center py-1 text-white/70 text-xs transition-colors hover:text-white"
      href="/changelog"
    >
      Latest update, v{latestVersion}
    </a>
    <h1
      class="mt-6 max-w-3xl text-balance font-medium text-4xl sm:text-5xl lg:text-6xl"
    >
      <span class="block">World-class docs for</span>
      <span class="block text-white/70">everything you ship</span>
    </h1>

    <!-- Tagline and install command on the left, links on the right -->
    <div
      class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
    >
      <div class="max-w-xl">
        <p class="text-balance text-lg text-white/80">
          Fast, AI-ready, and zero-config. Drop Markdown into a folder and ship
          a production-grade docs site, no app boilerplate to write or
          maintain. Free and open source, forever.
        </p>
        <div class="mt-8"><InstallBox variant="glass" /></div>
      </div>
      <div class="flex shrink-0 items-center gap-6 text-sm">
    <a
      class="inline-flex items-center gap-1 whitespace-nowrap font-medium text-white/80 transition-colors hover:text-white"
      href={docsHref}
    >
      Read the docs
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
        set:html={chevronRight}
      ></svg>
    </a>
        {
          repoUrl && (
          <a
            class="inline-flex items-center gap-1 whitespace-nowrap font-medium text-white/80 transition-colors hover:text-white"
            href={repoUrl}
            rel="noreferrer"
            target="_blank"
          >
            View source
            <svg
              class="size-3.5"
              fill="none"
              height="14"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="14"
              xmlns="http://www.w3.org/2000/svg"
              set:html={chevronRight}
            ></svg>
          </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-[1400px] sm:mt-24">
    <ProductPreview />
  </div>
</section>

<style>
  /* Day sky in light mode, night sky in dark mode: the same radial shape with
     the stops swapped for deep navy, so the theme toggle reads as day → night.
     The tail mixes toward `--blume-background` in both. */
  .hero-gradient {
    --sky-1: rgb(31 83 144);
    --sky-2: rgb(38 88 150);
    --sky-3: rgb(47 95 156);
    --sky-4: rgb(55 104 163);
    --sky-5: rgb(72 120 176);
    --sky-6: rgb(93 137 186);
    background-image: radial-gradient(
      150% 108% at 50% -4%,
      var(--sky-1) 0%,
      var(--sky-2) 8%,
      var(--sky-3) 18%,
      var(--sky-4) 29%,
      var(--sky-5) 44%,
      var(--sky-6) 60%,
      color-mix(in oklab, var(--sky-6) 55%, var(--blume-background)) 70%,
      color-mix(in oklab, var(--sky-6) 22%, var(--blume-background)) 80%,
      var(--blume-background) 88%
    );
  }

  :global([data-theme="dark"]) .hero-gradient {
    --sky-1: rgb(3 8 22);
    --sky-2: rgb(5 12 30);
    --sky-3: rgb(8 17 40);
    --sky-4: rgb(11 24 52);
    --sky-5: rgb(16 33 68);
    --sky-6: rgb(22 44 84);
  }
</style>
