---
// "Migrate with an agent." — one interactive demo: the headline reads
// "Migrate from [Fumadocs]" where the bracketed brand is a dropdown trigger
// (logo + name + chevron). Picking another source swaps the trigger and the
// body copy; the install command below is the same for every source. With no JS
// the default (Fumadocs) panel stays visible. The copy button reuses the
// page-level delegated `data-blume-copy-install` handler in index.astro.
import Icon from "blume/components/Icon.astro";

// The `blume-migrate` skill install is identical for every source — pick a
// brand to see what the agent handles for it, then run the same one-liner.
const installCommand =
  "npx skills add haydenbleasel/blume --skill blume-migrate";

// Brand marks, each a full <svg> so it can be injected via set:html (and copied
// into the trigger by the client script). Monochrome marks use currentColor so
// they track the theme; brand-coloured marks stay fixed.
