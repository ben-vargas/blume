  fumadocs:
    '<svg class="size-full" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="blume-fuma" gradientTransform="rotate(45)"><stop offset="45%" stop-color="var(--blume-background)"/><stop offset="100%" stop-color="#dd7627"/></linearGradient></defs><circle cx="90" cy="90" r="87" fill="url(#blume-fuma)" stroke="#dd7627" stroke-width="6"/></svg>',
  mintlify:
    '<svg class="size-full" viewBox="-2.7 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill="#18E299" d="M18.4725 9.60528V3.91396C18.4725 3.30323 17.977 2.81641 17.3754 2.81641H11.6867C10.7931 2.81641 9.90842 2.99342 9.08564 3.32977C8.26285 3.67497 7.51085 4.17064 6.88271 4.80793L6.83847 4.85219C6.00684 5.69305 5.41408 6.73749 5.11328 7.88815C5.65296 7.74653 6.2103 7.67572 6.76767 7.66687C8.25399 7.64916 9.71378 8.12713 10.8993 9.02111C11.9698 9.81771 12.7837 10.9153 13.2261 12.181C13.6861 13.4644 13.7392 14.8629 13.3942 16.1817C14.5354 15.8808 15.5883 15.2878 16.4288 14.4558L16.473 14.4115C17.1011 13.7831 17.6054 13.0307 17.9504 12.2075C18.2955 11.3844 18.4636 10.4993 18.4636 9.60528H18.4725Z"/><path fill="#0C8C5E" d="M4.9434 9.50941C4.95221 7.76347 5.64849 6.08807 6.87361 4.83594L2.14058 9.57113C2.12296 9.58876 2.10532 9.59758 2.08769 9.61522C0.933084 10.7615 0.23681 12.2959 0.122231 13.9183C0.0164654 15.435 0.413078 16.934 1.2592 18.1862C1.33991 18.3056 1.5589 18.3449 1.68229 18.2303L4.58202 15.338C5.48985 14.4298 5.7719 13.0806 5.34002 11.8726C5.06679 11.1231 4.93459 10.3207 4.9434 9.50941Z"/><path fill="#0C8C5E" d="M16.4445 14.4121C15.5367 15.3027 14.3997 15.92 13.1658 16.1933C11.923 16.4667 10.6362 16.3873 9.43757 15.9641C9.43757 15.9641 9.42874 15.9641 9.41992 15.9641C8.21243 15.532 6.86394 15.8141 5.95612 16.7136L3.05634 19.6058C2.93295 19.7293 2.95057 19.9321 3.10041 20.0291C4.35197 20.8668 5.85035 21.2724 7.36632 21.1666C8.98806 21.052 10.5128 20.3553 11.6674 19.2002L11.7115 19.1561L16.4445 14.4209V14.4121Z"/></svg>',
  nextra:
    '<svg class="size-full" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M22.68 21.031c-4.98-4.98-4.98-13.083 0-18.063l.978-.978c.22-.22.342-.513.342-.825 0-.311-.122-.604-.342-.824-.44-.441-1.207-.44-1.648 0l-.979.978c-4.98 4.98-13.084 4.98-18.063 0L1.99.34a1.17 1.17 0 0 0-1.649 0 1.168 1.168 0 0 0 0 1.649l.978.978c4.98 4.98 4.98 13.083 0 18.063l-.977.978c-.221.22-.342.513-.342.825 0 .31.121.604.341.824.442.443 1.21.441 1.65 0l.977-.977c4.98-4.983 13.083-4.98 18.064 0l.978.977c.22.22.513.342.824.342.312 0 .605-.122.824-.342.22-.22.342-.512.342-.824 0-.313-.122-.605-.342-.825l-.977-.978z"/></svg>',
  starlight:
    '<svg class="size-full" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="blume-starlight" x1="2.5" x2="21.61" y1="2.65" y2="25.4" gradientUnits="userSpaceOnUse"><stop stop-color="var(--starlight-gold-1, #FBD57F)"/><stop offset="1" stop-color="var(--starlight-gold-2, #D17F0D)"/></linearGradient></defs><path fill="url(#blume-starlight)" fill-rule="evenodd" d="M15.22 7.77 12.06.94 8.91 7.77l-.15.29L7 6.3a1.18 1.18 0 1 0-1.68 1.68l1.75 1.74-.2.1-.04.02L0 13l6.83 3.16.24.11-1.75 1.76A1.18 1.18 0 1 0 7 19.7l1.76-1.76.15.3 3.15 6.82 3.16-6.83.12-.24 1.71 1.71a1.18 1.18 0 1 0 1.68-1.67L17 16.3l.29-.15L24.13 13 17.3 9.84 17 9.7l1.73-1.73a1.18 1.18 0 1 0-1.68-1.67L15.35 8a4.15 4.15 0 0 1-.12-.21l-.01-.03Zm-3.17.36-.42.9a7.27 7.27 0 0 1-3.55 3.55l-.9.42.9.42a7.27 7.27 0 0 1 3.55 3.55l.42.9.42-.9a7.27 7.27 0 0 1 3.55-3.55l.9-.42-.9-.42a7.27 7.27 0 0 1-3.55-3.55l-.42-.9Z" clip-rule="evenodd"/><path fill="url(#blume-starlight)" d="M22.27 4.43a1.18 1.18 0 1 0-1.67-1.68l-.57.57a1.18 1.18 0 0 0 1.68 1.67l.56-.56ZM4.2 5.18c-.46.46-1.2.46-1.67 0l-.56-.56a1.18 1.18 0 0 1 1.67-1.68l.57.57c.46.46.46 1.2 0 1.67Zm0 15.64a1.18 1.18 0 0 0-1.67 0l-.56.56a1.18 1.18 0 0 0 1.67 1.68l.57-.57c.46-.46.46-1.2 0-1.67Zm18.07.75a1.18 1.18 0 0 1-1.67 1.68l-.57-.57a1.19 1.19 0 0 1 1.68-1.67l.56.56Z"/></svg>',
};

const sources = [
  {
    body: "The agent moves your content/docs tree into place, turns every meta.json into a typed meta.ts, and rewrites Cards, Accordions, Tabs, and includes to Blume's components — frontmatter and folder order intact.",
    id: "fumadocs",
    logo: logos.fumadocs,
    name: "Fumadocs",
  },
  {
    body: "The agent translates docs.json to blume.config.ts, reshapes config-driven navigation into folders and tabs, rewrites callouts to directives, inlines snippets, and maps FontAwesome icons to their Lucide equivalents.",
    id: "mintlify",
    logo: logos.mintlify,
    name: "Mintlify",
  },
  {
    body: "The agent maps docusaurus.config and sidebars.js onto Blume, keeps your admonitions as directives, converts Tabs and _category_.json, and reports the swizzled-theme chrome it can't carry over.",
    id: "docusaurus",
    logo: logos.docusaurus,
    name: "Docusaurus",
  },
  {
    body: "The agent reads your starlight() config and src/content/docs collection, turns asides into directives, renames CardGrid, LinkCard, and TabItem, and maps the Starlight icon set to Lucide.",
    id: "starlight",
    logo: logos.starlight,
    name: "Starlight",
  },
  {
    body: "The agent brings your Nextra pages across as Blume MDX and turns every _meta file into a typed meta.ts — navigation order and frontmatter intact, callouts converted to directives.",
    id: "nextra",
    logo: logos.nextra,
    name: "Nextra",
  },
];

const active = sources[0];

// Open/close the brand menu, then mirror the chosen option into the trigger
// (logo + label) and reveal its panel. Click-outside / Escape close. Astro's
// ClientRouter runs an inline script once per session, so this delegates from
// `document` (bound once, guarded by a global flag) and looks the picker up
// per event, which keeps it alive after router swaps replace the section.
const migrateScript = `(()=>{if(window.__blumeMigrate){return;}window.__blumeMigrate=true;const setOpen=(root,o)=>{root.querySelector("[data-migrate-trigger]").setAttribute("aria-expanded",String(o));root.querySelector("[data-migrate-menu]").dataset.open=String(o);};const select=(root,id)=>{const options=[...root.querySelectorAll("[data-migrate-option]")];options.forEach((o)=>o.setAttribute("aria-selected",String(o.dataset.migrateOption===id)));root.querySelectorAll("[data-migrate-panel]").forEach((p)=>{p.dataset.active=String(p.dataset.migratePanel===id);});const o=options.find((it)=>it.dataset.migrateOption===id);if(o){const trigger=root.querySelector("[data-migrate-trigger]");trigger.querySelector("[data-trigger-label]").textContent=o.dataset.label;trigger.querySelector("[data-trigger-logo]").innerHTML=o.querySelector("[data-option-logo]").innerHTML;}setOpen(root,false);};document.addEventListener("click",(e)=>{const root=document.querySelector("[data-migrate]");const t=e.target;if(!root||!(t instanceof Element)){return;}const trigger=root.querySelector("[data-migrate-trigger]");if(trigger.contains(t)){setOpen(root,trigger.getAttribute("aria-expanded")!=="true");return;}const option=t.closest("[data-migrate-option]");if(option&&root.contains(option)){select(root,option.dataset.migrateOption);return;}if(!root.contains(t)){setOpen(root,false);}});document.addEventListener("keydown",(e)=>{if(e.key==="Escape"){const root=document.querySelector("[data-migrate]");if(root){setOpen(root,false);}}});})();`;
---

<!-- Migrate: the heading itself is the interactive brand picker -->
<section
  class="flex flex-col justify-center rounded-[20px] bg-muted px-6 py-12 text-center sm:px-10 sm:py-16"
  data-migrate
>
  <!-- "Migrate from [Brand]" — the trigger is bare inline text (logo + name +
       chevron) with no button chrome; only the hover underline hints it's a
       control. -->
  <div
    aria-level="2"
    class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-balance font-medium text-3xl tracking-tight sm:text-4xl"
    role="heading"
  >
    <span>Migrate from</span>
    <div class="relative">
      <button
        aria-expanded="false"
        aria-haspopup="listbox"
        class="group inline-flex cursor-pointer items-center gap-2"
        data-migrate-trigger
        type="button"
      >
        <span
          class="inline-flex size-[0.85em] shrink-0 items-center justify-center"
          data-trigger-logo
          set:html={active.logo}
        />
        <span
          class="underline decoration-2 decoration-transparent underline-offset-[6px] transition-colors group-hover:decoration-muted-foreground"
          data-trigger-label
        >
          {active.name}
        </span>
        <svg
          class="size-[0.7em] shrink-0 text-muted-foreground transition-transform group-aria-[expanded=true]:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>

      <!-- Brand menu (this keeps its own dropdown chrome) -->
      <div
        aria-label="Choose a docs tool to migrate from"
        class="font-sans pointer-events-none absolute left-1/2 z-20 mt-3 w-56 -translate-x-1/2 translate-y-1 rounded-blume border border-border bg-background p-1.5 text-left font-normal text-base tracking-normal opacity-0 shadow-black/5 shadow-lg transition data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
        data-migrate-menu
        data-open="false"
        role="listbox"
      >
        {
          sources.map((source) => (
            <button
              aria-selected={source.id === active.id ? "true" : "false"}
              class="group flex w-full items-center gap-3 rounded-md px-3 py-2 text-left text-foreground text-sm transition-colors hover:bg-muted aria-selected:bg-muted"
              data-label={source.name}
              data-migrate-option={source.id}
              role="option"
              type="button"
            >
              <span
                class="flex size-5 shrink-0 items-center justify-center"
                data-option-logo
                set:html={source.logo}
              />
              <span class="font-medium">{source.name}</span>
              <svg
                class="ml-auto size-4 text-accent opacity-0 transition-opacity group-aria-selected:opacity-100"
                fill="none"
                height="16"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="16"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Per-source description, then the single install command for every brand -->
  <div class="mt-6">
    {
      sources.map((source) => (
        <p
          class="mx-auto hidden max-w-xl text-balance text-muted-foreground leading-relaxed data-[active=true]:block sm:min-h-[4.5rem]"
          data-active={source.id === active.id ? "true" : "false"}
          data-migrate-panel={source.id}
        >
          {source.body}
        </p>
      ))
    }

    <div class="mx-auto mt-6 flex max-w-xl items-center gap-3 rounded-blume border border-border bg-background py-2 pr-2 pl-4">
      <span
        aria-hidden="true"
        class="select-none font-mono text-muted-foreground text-sm"
      >
        $
      </span>
      <code class="flex-1 truncate text-left font-mono text-foreground text-sm">
        {installCommand}
      </code>
      <button
        aria-label="Copy the blume-migrate install command"
        class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        data-blume-copy-install
        data-command={installCommand}
        type="button"
      >
        <Icon class="size-4" name="copy" size={16} />
      </button>
    </div>
  </div>
</section>

<script is:inline set:html={migrateScript} />

<style>
  /* Starlight's mark is gold: starlight.astro.build ships a deeper amber
     gradient on light and a paler one on dark, so mirror both. */
  :global([data-theme="dark"]) [data-migrate] {
    --starlight-gold-1: #fcecc5;
    --starlight-gold-2: #eebd52;
  }
</style>
