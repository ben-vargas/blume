---
// A two-tone heading over a list of features beside one visual, shared by the
// homepage's "Batteries included" and the CLI page's build loop. Each feature
// title is a disclosure button: the active one shows its summary and
// checklist, and the visual's `[data-panel]` of the same index becomes active
// (the `visual` slot must render one `[data-panel]` per feature, the first
// carrying `data-active`). A progress rail on the active item fills while the
// section is on screen and advances to the next feature when it completes,
// until a reader picks one themselves (hover or focus pauses it; reduced
// motion never starts it). The section is also a reveal container (see
// Motion.astro), so a visual can animate as it arrives.
import SectionHeading from "./SectionHeading.astro";
import TextLink from "./TextLink.astro";
import { icons, inlineCode } from "./shared.ts";

interface Feature {
  body: string;
  checklist: string[];
  title: string;
}

interface Props {
  features: Feature[];
  id: string;
  link?: { href: string; label: string };
  tagline: string;
  title: string;
}

const { features, id, link, tagline, title } = Astro.props;

// Delegated from `document` and bound once per session (Astro's ClientRouter
// runs inline scripts once), so it survives router swaps: clicks pick a
// feature and stop the auto-advance, the rail's `animationend` advances it,
// and an IntersectionObserver — armed for every section on each
// `astro:page-load` — only lets the rail run while its section is on screen.
const featureTabsScript = `(() => {
  if (window.__blumeFeatureTabs) { return; }
  window.__blumeFeatureTabs = true;
  const select = (root, index) => {
    for (const item of root.querySelectorAll("[data-feature]")) {
      const on = item.dataset.feature === String(index);
      item.toggleAttribute("data-active", on);
      item.querySelector("button").setAttribute("aria-expanded", String(on));
    }
    for (const panel of root.querySelectorAll("[data-panel]")) {
      panel.toggleAttribute("data-active", panel.dataset.panel === String(index));
    }
  };
  document.addEventListener("click", (event) => {
    const button = event.target instanceof Element && event.target.closest("[data-feature] button");
    const root = button && button.closest("[data-feature-tabs]");
    if (!root) { return; }
    root.removeAttribute("data-auto");
    select(root, button.closest("[data-feature]").dataset.feature);
  });
  document.addEventListener("animationend", (event) => {
    const rail = event.target instanceof Element && event.target.closest("[data-feature-rail]");
    const root = rail && rail.closest("[data-feature-tabs]");
    if (!root || !root.hasAttribute("data-auto")) { return; }
    const count = root.querySelectorAll("[data-feature]").length;
    select(root, (Number(rail.closest("[data-feature]").dataset.feature) + 1) % count);
  });
  const observed = new WeakSet();
  const observe = () => {
    for (const root of document.querySelectorAll("[data-feature-tabs]")) {
      if (observed.has(root)) { continue; }
      observed.add(root);
      new IntersectionObserver(([entry]) => {
        root.toggleAttribute("data-onscreen", entry.isIntersecting);
      }, { threshold: 0.35 }).observe(root);
    }
  };
  observe();
  document.addEventListener("astro:page-load", observe);
})();`;
---

<section data-auto data-feature-tabs data-reveal>
  <SectionHeading tagline={tagline} title={title}>
    {link && <TextLink href={link.href}>{link.label}</TextLink>}
  </SectionHeading>

  <div class="mt-12 grid items-start gap-x-16 gap-y-10 lg:grid-cols-[1fr_2fr]">
    <!-- Features: one disclosure per feature; the active one expands -->
    <div class="lg:pt-6">
      {
        features.map((feature, index) => (
          <div
            class="group relative pl-5"
            data-active={index === 0 ? "" : undefined}
            data-feature={index}
          >
            <span
              aria-hidden="true"
              class="absolute inset-y-0 left-0 w-0.5 overflow-hidden rounded-full bg-border"
            >
              <span
                class="feature-rail absolute inset-0 origin-top scale-y-0 rounded-full bg-foreground group-data-active:scale-y-100"
                data-feature-rail
              />
            </span>
            <h3 class="tracking-normal">
              <button
                aria-controls={`${id}-${index}`}
                aria-expanded={index === 0 ? "true" : "false"}
                class="w-full cursor-pointer py-2.5 text-left font-medium text-lg text-muted-foreground hover:text-foreground group-data-active:text-foreground sm:text-base"
                type="button"
              >
                {feature.title}
              </button>
            </h3>
            <div class="pb-5 group-not-data-active:hidden" id={`${id}-${index}`}>
              <p
                class="max-w-[56ch] text-pretty text-base text-muted-foreground sm:text-sm"
                set:html={inlineCode(feature.body)}
              />
              <ul class="mt-4 flex flex-col gap-2" role="list">
                {feature.checklist.map((item) => (
                  <li class="flex items-start gap-2 text-base text-foreground sm:text-sm">
                    <svg
                      aria-hidden="true"
                      class="h-lh size-4 shrink-0 text-accent"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      set:html={icons.check}
                    />
                    <span set:html={inlineCode(item)} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="min-w-0">
      <slot name="visual" />
    </div>
  </div>
</section>

<script is:inline set:html={featureTabsScript} />

<style>
  @keyframes feature-rail {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  /* Auto-advance: the active rail fills over the dwell time, paused while
     the section is off screen or the reader is hovering or focused in it. */
  [data-feature-tabs][data-auto] [data-feature][data-active] .feature-rail {
    animation: feature-rail 7s linear;
  }

  [data-feature-tabs]:not([data-onscreen]) .feature-rail,
  [data-feature-tabs]:hover .feature-rail,
  [data-feature-tabs]:focus-within .feature-rail {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-rail {
      animation: none !important;
    }
  }
</style>
