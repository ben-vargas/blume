---
// The single-line install box (x.ai-style): a `$` prompt, the command, and a
// copy button. Shared by the hero and the install CTA so they stay identical.
// The copy button is wired to the page-level delegated `data-blume-copy-install`
// handler in index.astro (which swaps the icon to a checkmark on copy).
//
// `variant="glass"` is the install CTA's translucent take for sitting on its
// cornflower panel: a frosted white fill, white text, and a gradient white border
// drawn by a masked pseudo-element (so the border itself fades from bright at
// the top-left to faint at the bottom-right rather than being a flat line).
// The default variant is the opaque box for the page background.
import Icon from "blume/components/Icon.astro";
import { installCommand } from "./shared.ts";

interface Props {
  variant?: "default" | "glass";
}

const { variant = "default" } = Astro.props;
const glass = variant === "glass";

const box = glass
  ? "install-glass relative isolate flex w-full max-w-xs items-center gap-3 rounded-blume bg-white/10 py-2 pr-2 pl-4 text-white shadow-[0_1px_2px_rgb(0_0_0/0.08),inset_0_1px_0_rgb(255_255_255/0.12)] backdrop-blur-md"
  : "flex w-full max-w-xs items-center gap-3 rounded-blume border border-border bg-background py-2 pr-2 pl-4";
const prompt = glass
  ? "select-none font-mono text-sm text-white/60"
  : "select-none font-mono text-muted-foreground text-sm";
const command = glass
  ? "flex-1 truncate text-left font-mono text-sm text-white"
  : "flex-1 truncate text-left font-mono text-foreground text-sm";
const button = glass
  ? "inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-white/70 transition-colors hover:bg-white/15 hover:text-white"
  : "inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";
---

<div class={box}>
  <span aria-hidden="true" class={prompt}>$</span>
  <code class={command}>{installCommand}</code>
  <button
    aria-label="Copy install command"
    class={button}
    data-blume-copy-install
    data-command={installCommand}
    type="button"
  >
    <Icon class="size-4" name="copy" size={16} />
  </button>
</div>

<style>
  /* Gradient white border: a 1px ring painted by a pseudo-element whose mask
     keeps only the border area, so the fill underneath stays translucent. */
  .install-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.7) 0%,
      rgb(255 255 255 / 0.25) 50%,
      rgb(255 255 255 / 0.12) 100%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
</style>
