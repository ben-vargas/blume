---
// One bento card: a decorative illustration (the default slot) centered in
// the space above the caption, over a faint dot grid that fades out from the
// middle, with the caption at the bottom-left. Cards live in a
// <dl>, so the caption is the card's dt/dd pair; the illustration is a
// trailing dd, hidden from assistive tech and search snippets, that `order`
// lifts above the caption. It stays in the flow, so a caption that wraps on a
// narrow screen pushes the card taller instead of running into the art.
// `body` may mark code spans with backticks. Each card is its own reveal
// container (see Motion.astro), so its illustration animates as it scrolls
// into view.
import "./bloom.css";
import { inlineCode } from "./shared.ts";

interface Props {
  body: string;
  class?: string;
  title: string;
}

const { body, class: className, title } = Astro.props;
---

<div
  class:list={[
    "isolate flex flex-col gap-1 overflow-hidden rounded-[28px] bg-muted p-6 inset-ring inset-ring-foreground/5 sm:min-h-96 sm:p-8",
    className,
  ]}
  data-reveal
>
  <dt class="font-medium text-base text-foreground sm:text-sm">{title}</dt>
  <dd
    class="max-w-[48ch] text-pretty text-base text-muted-foreground sm:text-sm"
    set:html={inlineCode(body)}
  />
  <dd
    aria-hidden="true"
    class="relative -mx-6 -mt-6 order-first flex min-h-60 flex-1 items-center justify-center py-10 sm:-mx-8 sm:-mt-8"
    data-nosnippet
  >
    <div class="bento-backdrop absolute inset-0 -z-10"></div>
    <slot />
  </dd>
</div>

<style>
  /* The bloom's dot lattice, fading out toward the card's edges so the
     illustration sits at its densest point. */
  .bento-backdrop {
    mask-image: radial-gradient(70% 80% at 50% 50%, black 20%, transparent);
  }

  .bento-backdrop::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: color-mix(in oklab, var(--blume-foreground) 16%, transparent);
    mask-image: var(--bloom-dots);
    mask-size: var(--bloom-dots-size);
  }
</style>
