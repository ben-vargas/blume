---
// The page's one container language, shared with the agent-native
// scorecards: a single 28px-radius surface with a hairline inset edge. `tone`
// picks the fill — `muted` for plain wells, `bloom` for the one the feature
// mocks float on: pale cornflower light rising from beneath the mock over a
// faint hex grid of dots, the petals of the Blume mark repeated (see
// bloom.css; deeper in dark mode). Cards nested in a `p-2` muted tray
// take `rounded-[20px]` to stay concentric.
import "./bloom.css";

interface Props {
  class?: string;
  innerClass?: string;
  tone?: "bloom" | "muted";
}

const { class: className, innerClass, tone = "muted" } = Astro.props;
---

<div
  class:list={[
    "rounded-[28px] inset-ring inset-ring-foreground/5",
    tone === "bloom" ? "tray-bloom relative isolate" : "bg-muted",
    className,
    innerClass,
  ]}
>
  <slot />
</div>

<style>
  /* Deepest at the bottom-center, where the mock's shadow lands, fading up
     and out to a whisper of petal over the muted surface. */
  .tray-bloom {
    background-color: color-mix(in oklab, var(--bloom-6) 10%, var(--blume-muted));
    background-image:
      radial-gradient(
        70% 60% at 50% 100%,
        color-mix(in oklab, var(--bloom-6) 55%, transparent),
        transparent 75%
      ),
      radial-gradient(
        40% 35% at 50% 100%,
        color-mix(in oklab, var(--bloom-4) 30%, transparent),
        transparent 80%
      );
  }

  /* The dot lattice, strongest around the mock and gone by the edges. */
  .tray-bloom::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background-color: var(--bloom-3);
    mask-image:
      var(--bloom-dots),
      radial-gradient(60% 70% at 50% 45%, black, transparent);
    mask-composite: intersect;
    mask-size:
      var(--bloom-dots-size),
      100% 100%;
    opacity: 0.35;
  }

  :global([data-theme="dark"]) .tray-bloom {
    background-color: color-mix(in oklab, var(--bloom-4) 35%, var(--blume-background));
  }

  :global([data-theme="dark"]) .tray-bloom::before {
    background-color: var(--bloom-7);
  }
</style>
