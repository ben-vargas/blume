---
// The page's one container language, shared with the hero preview and the
// agent-native scorecards: an outer tray (hairline ring, 8px padding) holding
// an inner surface with a concentric radius. `tone` picks the inner surface —
// `muted` for plain wells, `sky` for the soft gradient the feature mocks float
// on, a quiet echo of the hero sky (navy at night in dark mode).
interface Props {
  class?: string;
  innerClass?: string;
  tone?: "muted" | "sky";
}

const { class: className, innerClass, tone = "muted" } = Astro.props;
---

<div
  class:list={[
    "rounded-(--tray-radius) bg-background p-(--tray-padding) shadow-[0_0_0_1px_var(--color-border)] [--tray-padding:--spacing(2)] [--tray-radius:28px]",
    className,
  ]}
>
  <div
    class:list={[
      "rounded-[calc(var(--tray-radius)-var(--tray-padding))]",
      tone === "sky" ? "tray-sky" : "bg-muted",
      innerClass,
    ]}
  >
    <slot />
  </div>
</div>

<style>
  /* Deepest at the bottom-left, washing out to near-white at the top-right,
     over a faint sky tint — the hero's blue at a whisper. */
  .tray-sky {
    --sky: rgb(72 120 176);
    --sky-glow: var(--blume-background);
    background-color: color-mix(in oklab, var(--sky) 12%, var(--blume-background));
    background-image:
      radial-gradient(
        100% 90% at 0% 100%,
        color-mix(in oklab, var(--sky) 50%, transparent),
        transparent 70%
      ),
      radial-gradient(
        80% 70% at 100% 0%,
        color-mix(in oklab, var(--sky-glow) 80%, transparent),
        transparent 70%
      );
  }

  :global([data-theme="dark"]) .tray-sky {
    --sky: rgb(22 44 84);
    --sky-glow: rgb(11 24 52);
    background-color: color-mix(in oklab, var(--sky) 45%, var(--blume-background));
  }
</style>
