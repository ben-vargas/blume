---
// The compare index (/compare): a directory of the per-tool pages (each card
// from _compare/tools.ts), where Blume sits among hosted platforms and
// frameworks you own, the homepage's Migrate picker, and the install CTA.
// Built in the homepage's design language, like the pages it links to.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Directory from "../_compare/Directory.astro";
import Models from "../_compare/Models.astro";
import { tools } from "../_compare/tools.ts";
import Footer from "../_home/Footer.astro";
import InstallCta from "../_home/InstallCta.astro";
import Migrate from "../_home/Migrate.astro";
import Motion from "../_home/Motion.astro";
import { installCopyScript } from "../_home/shared.ts";

const { config } = data;
const names = new Intl.ListFormat("en", { type: "conjunction" }).format(
  tools.map((tool) => tool.source.name)
);
// The title drops the list's "and" to stay inside a search result's width.
const pageTitle = `Blume vs ${tools.map((tool) => tool.source.name).join(", ")}`;
const pageDescription = `How Blume compares with ${names} on price, hosting, agent features, API references, and migration.`;
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/compare", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <Directory />

    <Models />

    <div class="scroll-mt-24" id="migrate">
      <Migrate />
    </div>

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <Footer slot="footer" />
</PageLayout>
