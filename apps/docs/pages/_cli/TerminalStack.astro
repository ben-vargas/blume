---
// A terminal window shared by the homepage's CLI panel and the /cli page.
// `glass` (for dark panels) is a frosted pane over a blurred sky glow;
// `solid` (for light ones) is the plain dark window with a soft drop shadow.
// It stacks one <FeatureTerminal>
// session per `kinds` entry in a fixed-height frame (`class` sets the
// height), with long sessions fading out at the bottom. The first session
// starts active; a script can move `data-active` between the `[data-panel]`
// wrappers to crossfade sessions. Inside a reveal container (see
// _home/Motion.astro) the active session prints line by line once it's in
// view, and again whenever another session becomes active; before then its
// lines wait hidden, so the reveal isn't a flash of the full log.
import FeatureTerminal from "./FeatureTerminal.astro";

interface Props {
  class?: string;
  kinds: string[];
  surface?: "glass" | "solid";
}

const { class: className, kinds, surface = "glass" } = Astro.props;
---

<div class="relative min-w-0">
  {
    surface === "glass" && (
      <div
        aria-hidden="true"
        class="terminal-glow pointer-events-none absolute -inset-12"
      />
    )
  }
  <div
    class:list={[
      "relative isolate overflow-hidden rounded-2xl",
      surface === "glass"
        ? "terminal-glass bg-white/[0.04] backdrop-blur-xl"
        : "terminal-solid bg-[#0d0f12] outline-1 -outline-offset-1 outline-white/10",
      className,
    ]}
    data-nosnippet
  >
    {
      kinds.map((kind, index) => (
        <div
          class="invisible absolute inset-0 opacity-0 transition-[opacity,visibility] duration-300 [mask-image:linear-gradient(to_bottom,black_78%,transparent)] data-active:visible data-active:opacity-100"
          data-active={index === 0 ? "" : undefined}
          data-panel={index}
        >
          <FeatureTerminal kind={kind} surface="glass" />
        </div>
      ))
    }
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global([data-inview]) [data-panel][data-active] :global([data-line]) {
      animation: terminal-line 0.35s ease-out both;
      animation-delay: calc(var(--line) * 45ms + 150ms);
    }

    :global([data-reveal-armed]:not([data-inview]))
      [data-panel]
      :global([data-line]) {
      opacity: 0;
    }
  }

  @keyframes terminal-line {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
  }

  /* The hero's sky, pooled behind the terminal and blurred soft. */
  .terminal-glow {
    background:
      radial-gradient(
        45% 50% at 65% 40%,
        rgb(72 120 176 / 0.45),
        transparent 70%
      ),
      radial-gradient(
        40% 40% at 25% 85%,
        rgb(47 95 156 / 0.3),
        transparent 70%
      );
    filter: blur(24px);
  }

  .terminal-solid {
    box-shadow: 0 40px 80px -24px rgb(28 40 64 / 0.45);
  }

  :global([data-theme="dark"]) .terminal-solid {
    box-shadow: none;
  }

  /* Glass: a bright top edge and a 1px border that fades from the top-left
     corner (a masked pseudo-element, like the hero's install box), over a
     deep drop shadow. */
  .terminal-glass {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 40px 80px -24px rgb(0 0 0 / 0.6);
  }

  .terminal-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.35) 0%,
      rgb(255 255 255 / 0.1) 40%,
      rgb(255 255 255 / 0.05) 100%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
</style>
