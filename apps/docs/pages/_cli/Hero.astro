---
// CLI page hero — the agents page's centered layout on the plain page (the
// two-tone headline, the summary, and the install box with its two links
// beneath), over a wide bloom tray where the lifecycle session types itself out
// on load and idles on a blinking prompt. The install box copy button uses
// the page-level delegated `data-blume-copy-install` handler.
import InstallBox from "../_home/InstallBox.astro";
import TextLink from "../_home/TextLink.astro";
import Tray from "../_home/Tray.astro";
import FeatureTerminal from "./FeatureTerminal.astro";
---

<section class="flex flex-col gap-12 pt-8 sm:pt-12 lg:gap-16">
  <div class="flex flex-col items-center gap-8 text-center">
    <h1
      class="max-w-[20ch] text-balance font-medium text-4xl sm:text-5xl lg:text-6xl"
    >
      <span class="block">Everything your docs need,</span>
      <span class="block text-muted-foreground">one command away.</span>
    </h1>
    <p class="max-w-[56ch] text-pretty text-lg text-muted-foreground">
      Every Blume project ships with a command line that scaffolds, previews,
      builds, validates, audits, evaluates, and translates your docs. Fast by
      default, scriptable in CI, and built to work with your coding agents.
    </p>
    <div class="flex w-full flex-col items-center gap-5">
      <div class="w-full max-w-xs">
        <InstallBox />
      </div>
      <div class="flex items-center gap-6">
        <TextLink href="/docs/quickstart">Get started</TextLink>
        <TextLink href="/docs/cli">CLI reference</TextLink>
      </div>
    </div>
  </div>

  <Tray innerClass="flex justify-center overflow-hidden px-4 pt-10 pb-12 sm:px-10 sm:pt-16 sm:pb-16" tone="bloom">
    <div
      class="hero-terminal w-full max-w-3xl overflow-hidden rounded-2xl outline-1 -outline-offset-1 outline-white/10"
      data-nosnippet
    >
      <FeatureTerminal caret kind="hero" />
    </div>
  </Tray>
</section>

<style>
  .hero-terminal {
    box-shadow: 0 40px 80px -24px rgb(28 40 64 / 0.45);
  }

  :global([data-theme="dark"]) .hero-terminal {
    box-shadow: none;
  }

  /* The session types itself out once, on load: each line lands a beat
     after the last, ending on the blinking prompt. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-terminal :global([data-line]) {
      animation: hero-line 0.4s ease-out both;
      animation-delay: calc(var(--line) * 110ms + 300ms);
    }
  }

  @keyframes hero-line {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
  }
</style>
