---
// The `blume audit` spotlight, as the CLI page's one dark panel (the same
// treatment as the homepage's CLI teaser): a two-tone heading with its docs
// link, a wide glass terminal printing the report in the reporter's real
// format, and a hairline row of what makes it different beneath. In dark
// mode the panel lifts one step off the page instead of vanishing into it.
import SectionHeading from "../_home/SectionHeading.astro";
import TextLink from "../_home/TextLink.astro";
import { inlineCode } from "../_home/shared.ts";
import TerminalStack from "./TerminalStack.astro";

const strengths = [
  {
    body: "Because Blume built the site, a finding on one of your pages points at its source file, and at the frontmatter line when the key is there to fix, not just the URL a crawler saw.",
    title: "Findings that name the fix.",
  },
  {
    body: "Fail on errors by default and tighten to warnings when you're ready; `--url` also probes a live deployment for what only the real server can tell you.",
    title: "A CI gate you control.",
  },
  {
    body: "Hand the report to Codex or Claude Code: it fixes each finding at the source, rebuilds, and re-audits until the report comes back clean.",
    title: "Cleared by your agent.",
  },
];
---

<section
  class="overflow-hidden rounded-[28px] bg-zinc-950 text-white dark:bg-muted dark:inset-ring dark:inset-ring-white/5"
  data-reveal
>
  <div class="flex flex-col gap-12 p-6 sm:p-10 lg:p-16">
    <SectionHeading
      tagline="Findings name the file that fixes them, not just the URL."
      title="Audit everything you ship."
      tone="inverse"
    >
      <TextLink href="/docs/cli/audit" tone="inverse">Read the audit docs</TextLink>
    </SectionHeading>
    <TerminalStack class="h-[28rem]" kinds={["report"]} />
  </div>

  <!-- Hairlines between the columns come from the 1px gap over a white/10
       fill, so they re-flow with the column count. -->
  <dl
    class="grid gap-px border-white/10 border-t bg-white/10 lg:grid-cols-3"
  >
    {
      strengths.map((strength) => (
        <div class="bg-zinc-950 p-6 text-base sm:p-8 sm:text-sm dark:bg-muted">
          <dt class="font-medium">{strength.title}</dt>
          <dd
            class="mt-1 text-pretty text-white/60 [&_code]:text-white"
            set:html={inlineCode(strength.body)}
          />
        </div>
      ))
    }
  </dl>
</section>
