---
// "Every command." — the CLI at a glance, in the homepage components grid's
// style: a two-tone heading over hairline rows, each a command beside its
// one-line summary (mirroring the CLI reference's table). Commands with their
// own docs page link there; the rest link to the reference overview.
import SectionHeading from "../_home/SectionHeading.astro";
import TextLink from "../_home/TextLink.astro";

const referenceHref = "/docs/cli";

const commands = [
  { name: "blume init", text: "Scaffold a project, interactive by default." },
  { name: "blume dev", text: "Start the dev server with hot reload." },
  { name: "blume build", text: "Build the static (or server) site." },
  { name: "blume preview", text: "Preview the last build." },
  { name: "blume add", text: "Install a source component from the registry." },
  { name: "blume sync", text: "Re-fetch remote content sources and regenerate." },
  {
    name: "blume eject",
    text: "Promote the runtime into a standalone Astro app.",
  },
  { name: "blume check", text: "Type-check the site with astro check." },
  {
    href: "/docs/cli/doctor",
    name: "blume doctor",
    text: "Diagnose config and content problems.",
  },
  {
    href: "/docs/cli/validate",
    name: "blume validate",
    text: "Validate links across your content.",
  },
  {
    href: "/docs/cli/audit",
    name: "blume audit",
    text: "Audit the built site for SEO and health issues.",
  },
  {
    href: "/docs/cli/evals",
    name: "blume eval",
    text: "Test the docs: an agent answers your questions using only the documentation.",
  },
  {
    href: "/docs/cli/translate",
    name: "blume translate",
    text: "Translate docs into the configured locales with a local agent CLI.",
  },
  {
    href: "/docs/cli/version",
    name: "blume version",
    text: "Freeze the current docs as an archived version.",
  },
  {
    href: "/docs/migrating",
    name: "blume migrate",
    text: "Move a site from another docs framework, with your agent.",
  },
  {
    href: "/docs/upgrading",
    name: "blume upgrade",
    text: "Move to a new major, or hand the upgrade to your agent.",
  },
];
---

<section>
  <SectionHeading
    tagline="Every flag documented in the CLI reference."
    title="Every command."
  >
    <TextLink href={referenceHref}>Read the CLI reference</TextLink>
  </SectionHeading>

  <ul class="mt-12 grid gap-x-16 sm:grid-cols-2" data-reveal role="list">
    {
      commands.map((command, index) => (
        <li
          class="reveal-rise border-border border-t"
          style={`--reveal-delay: ${(index % 2) * 80 + Math.floor(index / 2) * 40}ms`}
        >
          <a
            class="group grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-baseline sm:gap-6"
            href={command.href ?? referenceHref}
          >
            <code class="font-medium font-mono text-foreground text-sm group-hover:text-accent">
              {command.name}
            </code>
            <p class="text-pretty text-base text-muted-foreground sm:text-sm">
              {command.text}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
