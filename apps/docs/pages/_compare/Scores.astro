---
// Agent readiness, head to head: one card per independent scanner, each with
// a bar for Blume's docs and one for the other tool's, styled like the
// homepage scorecards. The bars grow and the numbers count up as the section
// scrolls into view (see _home/Motion.astro); the footnote dates the scans.
import SectionHeading from "../_home/SectionHeading.astro";
import TextLink from "../_home/TextLink.astro";
import type { CompareTool } from "./tools.ts";
import { scoresDate } from "./tools.ts";

interface Props {
  scores: NonNullable<CompareTool["scores"]>;
  tool: CompareTool;
}

const { scores, tool } = Astro.props;
---

<section class="flex flex-col gap-12" data-reveal>
  <SectionHeading
    tagline="Scores from two independent scanners."
    title="Agent readiness, measured."
  >
    <TextLink href="/docs/discoverability">How Blume gets there</TextLink>
  </SectionHeading>

  <div class="flex flex-col gap-3">
    <div class="grid gap-4 md:grid-cols-2">
      {
        scores.map((scan, card) => (
          <article class="flex flex-col gap-8 rounded-[28px] bg-muted p-6 inset-ring inset-ring-foreground/5 sm:p-8">
            <div class="flex items-center justify-between gap-4">
              <p class="font-medium">{scan.name}</p>
              <TextLink external href={scan.href}>
                View report
              </TextLink>
            </div>
            <dl class="flex flex-col gap-6">
              {[
                { label: "Blume", score: scan.blume, strong: true },
                { label: tool.source.name, score: scan.them, strong: false },
              ].map((row, index) => (
                <div class="flex flex-col gap-2">
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class:list={["text-sm", row.strong ? "font-medium" : "text-muted-foreground"]}>
                      {row.label}
                    </dt>
                    <dd class="font-medium text-2xl tabular-nums">
                      <span
                        class:list={[!row.strong && "text-muted-foreground"]}
                        data-count-delay={card * 180 + index * 120}
                        data-count-to={row.score}
                      >
                        {row.score}
                      </span>
                      <span class="text-muted-foreground">/100</span>
                    </dd>
                  </div>
                  <div class="h-2 overflow-hidden rounded-full bg-border">
                    <div
                      class:list={[
                        "reveal-grow h-full w-(--score) rounded-full",
                        row.strong ? "bg-accent" : "bg-foreground/40",
                      ]}
                      style={`--score: ${row.score}%; --reveal-delay: ${card * 180 + index * 120}ms`}
                    />
                  </div>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
    <p class="text-muted-foreground text-xs">
      Scores are as reported by {scores.map((scan) => scan.name).join(" and ")}{" "}
      on {scoresDate}, and may have changed since.
    </p>
  </div>
</section>
