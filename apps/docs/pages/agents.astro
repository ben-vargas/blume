---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Connect from "./_agents/Connect.astro";
import Hero from "./_agents/Hero.astro";
import Skills from "./_agents/Skills.astro";
import Surface from "./_agents/Surface.astro";
import Workflows from "./_agents/Workflows.astro";
import AgentNative from "./_home/AgentNative.astro";
import Footer from "./_home/Footer.astro";
import InstallCta from "./_home/InstallCta.astro";
import Motion from "./_home/Motion.astro";
import { installCopyScript } from "./_home/shared.ts";

// The agents landing page, in the homepage's design language with its own
// centered hero (a coding agent's session against a Blume site's MCP server).
// It runs in two acts. Agents reading your docs: the discoverability bento
// (this page's alone; the homepage has a simpler take), the MCP server and its
// connect menu up close, publishing your own skills, and the agent-readiness
// scores. Then agents helping you write them:
// the update-docs skill, evals, translation, audit hand-off, and migration.
const { config } = data;
const pageTitle = `${config.title} for agents — docs agents can read, and help you write`;
const pageDescription =
  "Every Blume site serves llms.txt, Markdown mirrors, and a JSON API, can host an MCP server and publish your agent skills, and ships agent tooling to test, translate, and update your docs.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/agents", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <Hero />

    <Surface />

    <Connect />

    <Skills />

    <AgentNative />

    <Workflows />

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <Footer slot="footer" />
</PageLayout>
